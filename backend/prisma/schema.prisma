generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Song {
  id           Int           @id @default(autoincrement())
  name         String
  key          KeyType
  bpm          Int
  text         String
  audio        String
  danceVideo   String
  structure    String[]
  programSongs ProgramSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramSong {
  id        Int     @id @default(autoincrement())
  programId Int
  program   Program @relation(fields: [programId], references: [id])
  songId    Int
  song      Song    @relation(fields: [songId], references: [id])
  order     Int

  @@unique([programId, songId])
  @@index([programId, order])
}

model Program {
  id     Int    @id @default(autoincrement())
  leader String
  name   String

  songs ProgramSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum KeyType {
  C
  D
  E
  F
  G
  A
  H
}
